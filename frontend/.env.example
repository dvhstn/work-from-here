# Copy to .env.local to override. Only VITE_-prefixed values reach the browser.

# Image CDN (imgproxy) that serves space photos by object key.
# Optional in dev (defaults to http://localhost:8090). REQUIRED for production
# builds: without it, photos are requested from the site's own origin and an
# error is logged in the console.
VITE_CDN_BASE_URL=http://localhost:8090
